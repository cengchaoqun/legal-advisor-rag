# 运行模式：live（真实依赖）/ test（仅测试，允许明确标识的离线替身）
APP_MODE=live

# 中间件（本机受控）
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=legal_rag
MILVUS_URI=http://127.0.0.1:19530
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=legal-rag

# 最终回答模型：程序外微调并部署的 OpenAI 兼容推理服务（不得填辅助云模型）
LLM_BASE_URL=http://127.0.0.1:8008/v1
LLM_API_KEY=
LLM_MODEL=legal-labor-sft-v1
MODEL_DEPLOYMENT_MANIFEST=

# 辅助模型：仅用于法律要素抽取与 HyDE，不接管最终回答
AUX_LLM_BASE_URL=
AUX_LLM_API_KEY=
AUX_LLM_MODEL=qwen-flash

# 重排序
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank

# 联网检索（默认关闭；未配置时手动开启返回 unavailable）
MCP_URL=
MCP_API_KEY=

# 嵌入模型快照，必须在建索引前锁定
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# 价格配置（缺失时拒绝付费批任务）
PRICING_FILE=deploy/pricing.json
# 模型服务器导出的轻量tokenizer目录；不需要把8B权重复制到业务电脑
MODEL_TOKENIZER_PATH=
