{
  "openapi": "3.1.0",
  "info": {
    "title": "劳动用工咨询演示 API",
    "version": "0.4.0",
    "description": "设计契约，尚未实现。所有 JSON 错误遵循统一 Error。单人受控环境，无账号。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "get__health_live",
        "summary": "进程存活",
        "responses": {
          "200": {
            "description": "进程存活成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "get__health_ready",
        "summary": "依赖与配置就绪",
        "responses": {
          "200": {
            "description": "依赖与配置就绪成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "degraded",
                        "unready"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "unavailable",
                          "not_configured"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "operationId": "get__api_documents",
        "summary": "资料分页",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "doc_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "law",
                "interpretation",
                "case",
                "guidance",
                "unknown"
              ]
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "available",
                "limited",
                "unavailable"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "标题或当前发布版本文号/案号的字面子串；去首尾空白、忽略拉丁大小写，空白串422，不解释为正则；先过滤再分页"
          }
        ],
        "responses": {
          "200": {
            "description": "资料分页成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "./核心对象.schema.json#/$defs/DocumentListItem"
                      }
                    },
                    "next_cursor": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "后续游标"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "description": "一次返回资料、当前发布版本、派生 availability 和最近导入任务，无须逐条获取详情。availability 仅筛当前版本；无当前版本视为 unavailable；新版本失败不降低旧发布版本可用性。先过滤再分页。"
      },
      "post": {
        "operationId": "post__api_documents",
        "summary": "提交知识资料",
        "responses": {
          "202": {
            "description": "提交知识资料成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document_id": {
                      "type": "string",
                      "description": "业务 UUID",
                      "format": "uuid"
                    },
                    "version_id": {
                      "type": "string",
                      "description": "版本"
                    },
                    "task_id": {
                      "type": "string",
                      "description": "业务 UUID",
                      "format": "uuid"
                    },
                    "duplicate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "document_id",
                    "version_id",
                    "task_id",
                    "duplicate"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/LimitExceeded"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "title": {
                    "type": "string",
                    "description": "标题",
                    "maxLength": 200
                  },
                  "doc_type": {
                    "type": "string",
                    "enum": [
                      "law",
                      "interpretation",
                      "case",
                      "guidance",
                      "unknown"
                    ]
                  },
                  "source_url": {
                    "type": "string",
                    "description": "来源 URL",
                    "format": "uri"
                  },
                  "request_id": {
                    "type": "string",
                    "description": "业务 UUID",
                    "format": "uuid"
                  },
                  "replace_document_id": {
                    "type": "string",
                    "description": "业务 UUID",
                    "format": "uuid"
                  }
                },
                "required": [
                  "file",
                  "request_id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
