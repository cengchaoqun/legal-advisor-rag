    "/api/queries/{query_id}/events": {
      "get": {
        "operationId": "get__api_queries_query_id_events",
        "summary": "SSE 事件与重放",
        "parameters": [
          {
            "name": "query_id",
            "in": "path",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after_seq",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "持久化事件流",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "x-event-types": [
          "started",
          "stage",
          "evidence",
          "delta",
          "warning",
          "done",
          "failed",
          "cancelled"
        ],
        "description": "HTTP 错误仅在开始事件流前返回。200 建流后故障以持久化 failed/cancelled 事件报告；不在事件流中插入 JSON 错误响应。Last-Event-ID 必须属于当前 query，且与 after_seq 一致；超出 last_event_seq 返回 400。"
      }
    },
    "/api/queries/{query_id}/evidence/{evidence_id}": {
