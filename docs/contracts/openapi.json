    "/api/graph/relations": {
      "get": {
        "operationId": "get__api_graph_relations",
        "summary": "有界图关联",
        "parameters": [
          {
            "name": "entity_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_hops",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2,
              "default": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "有界图关联成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "$ref": "./核心对象.schema.json#/$defs/Path"
                      },
                      "maxItems": 50
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "警告"
                      }
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "$ref": "./核心对象.schema.json#/$defs/GraphEntity"
                      },
                      "maxItems": 150
                    },
                    "support_chunks": {
                      "type": "array",
                      "items": {
                        "$ref": "./核心对象.schema.json#/$defs/Chunk"
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "paths",
                    "warnings",
                    "nodes",
                    "support_chunks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "description": "只浏览已发布且未撤销的 knowledge 白名单。返回 paths、完整节点标签 nodes 和支持原文 support_chunks；支持切片总数最多100，按 path_id 顺序保留完整可定位路径，超限标 GRAPH_RESULT_TRUNCATED，禁止返回缺节点/缺证据的半条路径。empty 为200空数组；依赖失败为503。"
      }
    },
