{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/legal-rag/core.schema.json",
  "title": "劳动用工 RAG 核心契约 V0.4",
  "$defs": {
    "QualityFlag": {
      "type": "string",
      "enum": [
        "metadata_missing",
        "effectivity_unknown",
        "citation_unresolved",
        "graph_unavailable",
        "source_access_limited",
        "parser_partial",
        "citation_validation_failed"
      ]
    },
    "LegalMetadata": {
      "type": "object",
      "properties": {
        "jurisdiction": {
          "type": "string",
          "enum": [
            "CN-national",
            "unknown"
          ]
        },
        "issued_date": {
          "anyOf": [
            {
              "type": "string",
              "description": "公布日期",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_from": {
          "anyOf": [
            {
              "type": "string",
              "description": "生效日期",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_to": {
          "anyOf": [
            {
              "type": "string",
              "description": "终止日期，不含该日",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectivity": {
          "type": "string",
          "enum": [
            "known_current",
            "known_historical",
            "unknown"
          ]
        },
        "effectivity_source_chunk_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "效力字段的原文依据"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_number": {
          "anyOf": [
            {
              "type": "string",
              "description": "案号"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string",
              "description": "发文机关"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_number": {
          "anyOf": [
            {
              "type": "string",
              "description": "文号"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "jurisdiction",
        "issued_date",
        "effective_from",
        "effective_to",
        "effectivity",
        "effectivity_source_chunk_id",
        "case_number",
        "issuer",
        "document_number"
      ],
      "additionalProperties": false
    },
    "Location": {
      "type": "object",
      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "heading": {
          "anyOf": [
            {
              "type": "string",
              "description": "章节"
            },
            {
              "type": "null"
            }
          ]
        },
        "article": {
          "anyOf": [
            {
              "type": "string",
              "description": "条号"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "page",
        "heading",
        "article",
        "start_char",
        "end_char"
      ],
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "description": "资料标题",
          "minLength": 1,
          "maxLength": 200
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "law",
            "interpretation",
            "case",
            "guidance",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "knowledge",
            "session"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "业务 UUID",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_version_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前默认资料版本"
            },
            {
              "type": "null"
            }
          ]
        },
        "tombstoned": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "description": "UTC ISO 8601 时间",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "UTC ISO 8601 时间",
          "format": "date-time"
        }
      },
      "required": [
        "document_id",
        "title",
        "doc_type",
        "scope",
        "session_id",
        "current_version_id",
        "tombstoned",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Version": {
      "type": "object",
      "properties": {
        "version_id": {
          "type": "string",
          "description": "SHA256(document_id+内容摘要+处理器版本)"
        },
        "document_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "description": "文件 SHA256",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "description": "来源网址",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "object_key": {
          "type": "string",
          "description": "由系统产生的私有对象键"
        },
        "metadata": {
          "$ref": "#/$defs/LegalMetadata"
        },
        "publication_state": {
          "type": "string",
          "enum": [
            "staged",
            "published",
            "withdrawn"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "limited",
            "unavailable"
          ]
        },
        "vector_state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "ready",
            "failed"
          ]
        },
        "graph_state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "ready",
            "failed",
            "empty"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          }
        },
        "created_at": {
          "type": "string",
          "description": "UTC ISO 8601 时间",
          "format": "date-time"
        },
        "pipeline_revision": {
          "type": "string",
          "minLength": 1,
          "description": "解析器、切片、抽取、嵌入快照及配置的确定性处理指纹；不含运行时间或随机值"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "首次发布提交时间；未发布为 null，图重试不改首次时间"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version_id",
        "document_id",
        "sha256",
        "source_url",
        "object_key",
        "metadata",
        "publication_state",
        "availability",
        "vector_state",
        "graph_state",
        "quality_flags",
        "created_at",
        "pipeline_revision",
        "published_at"
      ],
      "additionalProperties": false
    },
    "Chunk": {
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string",
          "description": "SHA256(version_id+顺序+正文摘要)"
        },
        "document_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "description": "版本标识"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "string",
          "description": "权威正文",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "scenario_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "wage_arrears",
              "termination",
              "economic_compensation",
              "other"
            ]
          }
        },
        "embedding_revision": {
          "type": "string",
          "description": "模型标识与快照"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          }
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "version_id",
        "ordinal",
        "content",
        "location",
        "scenario_tags",
        "embedding_revision",
        "quality_flags"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "本地 chunk_id 或 web:URL+正文摘要"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "local",
            "web",
            "web_snippet",
            "attachment"
          ]
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "切片标识"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "本地资料版本"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "description": "来源标题"
        },
        "text": {
          "type": "string",
          "description": "供精排与生成的正文"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "description": "外部 URL",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "recall_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ordinary",
              "hyde",
              "graph",
              "web"
            ]
          }
        },
        "rank_score": {
          "type": "number"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          }
        }
      },
      "required": [
        "source_id",
        "source_type",
        "chunk_id",
        "version_id",
        "title",
        "text",
        "url",
        "location",
        "recall_sources",
        "rank_score",
        "rerank_score",
        "quality_flags"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "description": "本次 query 内编号",
          "pattern": "^E[1-9][0-9]*$"
        },
        "query_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "description": "候选来源标识"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "local",
            "web",
            "web_snippet",
            "attachment"
          ]
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "切片标识"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "版本标识"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "description": "来源标题"
        },
        "text": {
          "type": "string",
          "description": "冻结证据快照正文"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "description": "来源 URL",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegalMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          }
        }
      },
      "required": [
        "evidence_id",
        "query_id",
        "source_id",
        "source_type",
        "chunk_id",
        "version_id",
        "title",
        "text",
        "url",
        "location",
        "metadata",
        "quality_flags"
      ],
      "additionalProperties": false
    },
    "Path": {
      "type": "object",
      "properties": {
        "path_id": {
          "type": "string",
          "description": "路径稳定摘要"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "实体 ID"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "relation_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "HAS_VERSION",
              "HAS_PROVISION",
              "CITES",
              "CONCERNS",
              "ISSUED_BY",
              "SUPERSEDES",
              "SUPPORTED_BY"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        },
        "support_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "依据切片"
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "source_supported",
            "unresolved"
          ]
        },
        "version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "版本白名单"
          }
        }
      },
      "required": [
        "path_id",
        "node_ids",
        "relation_types",
        "support_chunk_ids",
        "status",
        "version_ids"
      ],
      "additionalProperties": false
    },
    "QueryRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "question": {
          "type": "string",
          "description": "用户问题",
          "minLength": 1,
          "maxLength": 2000
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "业务 UUID",
            "format": "uuid"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "业务 UUID",
            "format": "uuid"
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "relevant_date": {
          "anyOf": [
            {
              "type": "string",
              "description": "相关日期",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "description": "事实发生地域",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "web_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "request_id",
        "question"
      ],
      "additionalProperties": false
    },
    "QueryStatus": {
      "type": "object",
      "properties": {
        "query_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "completed_with_warnings",
            "failed",
            "interrupted",
            "cancelled"
          ]
        },
        "behavior": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "answer",
                "clarify",
                "insufficient"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "type": "string",
          "description": "终态或当前累计文本"
        },
        "citation_validation": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "稳定警告码"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "last_event_seq": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "description": "UTC ISO 8601 时间",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "description": "UTC ISO 8601 时间",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_model_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "实际回答模型服务标识"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "description": "部署产物摘要；无法核验时为 null"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "$ref": "#/$defs/Facts"
        },
        "path_status": {
          "$ref": "#/$defs/PathStatus"
        },
        "reasoning_code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "EVIDENCE_SUFFICIENT",
                "FACTS_MISSING",
                "NO_RELEVANT_EVIDENCE",
                "EVIDENCE_CONFLICT",
                "APPLICABILITY_UNCERTAIN"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query_id",
        "session_id",
        "status",
        "behavior",
        "answer",
        "citation_validation",
        "warnings",
        "evidence",
        "last_event_seq",
        "created_at",
        "finished_at",
        "generation_model_id",
        "generation_artifact_sha256",
        "facts",
        "path_status",
        "reasoning_code"
      ],
      "additionalProperties": false
    },
    "TaskStatus": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "description": "资料版本"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "succeeded_with_warnings",
            "failed",
            "cancelled"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "validate",
            "save_original",
            "parse",
            "split",
            "extract",
            "write_vectors",
            "write_graph",
            "publish",
            "done"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "limited",
            "unavailable"
          ]
        },
        "vector_state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "ready",
            "failed"
          ]
        },
        "graph_state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "ready",
            "failed",
            "empty"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "稳定警告码"
          }
        },
        "retryable": {
          "type": "boolean"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "description": "UTC ISO 8601 时间",
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "document_id",
        "version_id",
        "status",
        "stage",
        "availability",
        "vector_state",
        "graph_state",
        "warnings",
        "retryable",
        "attempt",
        "error",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定机器错误码"
        },
        "message": {
          "type": "string",
          "description": "中文可读描述"
        },
        "request_id": {
          "type": "string",
          "description": "业务 UUID",
          "format": "uuid"
        },
